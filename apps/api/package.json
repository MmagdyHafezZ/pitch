{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build:deps": "pnpm --filter @pitch/shared-backend build",
    "prebuild": "pnpm run build:deps",
    "build": "tsc -p tsconfig.build.json --incremental false && tsc-alias -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "ts-node-dev --respawn --transpile-only --ignore-watch node_modules --project tsconfig.json -r tsconfig-paths/register src/main.ts",
    "dev:gateway": "MICROSERVICE=gateway ts-node-dev --respawn --transpile-only --ignore-watch node_modules --project tsconfig.json -r tsconfig-paths/register src/main.ts",
    "dev:user": "MICROSERVICE=user ts-node-dev --respawn --transpile-only --ignore-watch node_modules --project tsconfig.json -r tsconfig-paths/register src/main.ts",
    "dev:simulation": "MICROSERVICE=simulation ts-node-dev --respawn --transpile-only --ignore-watch node_modules --project tsconfig.json -r tsconfig-paths/register src/main.ts",
    "dev:support": "MICROSERVICE=support ts-node-dev --respawn --transpile-only --ignore-watch node_modules --project tsconfig.json -r tsconfig-paths/register src/main.ts",
    "dev:analytics": "MICROSERVICE=analytics ts-node-dev --respawn --transpile-only --ignore-watch node_modules --project tsconfig.json -r tsconfig-paths/register src/main.ts",
    "dev:lti": "MICROSERVICE=lti ts-node-dev --respawn --transpile-only --ignore-watch node_modules --project tsconfig.json -r tsconfig-paths/register src/main.ts",
    "dev:s3": "MICROSERVICE=s3 ts-node-dev --respawn --transpile-only --ignore-watch node_modules --project tsconfig.json -r tsconfig-paths/register src/main.ts",
    "dev:crm": "MICROSERVICE=crm ts-node-dev --respawn --transpile-only --ignore-watch node_modules --project tsconfig.json -r tsconfig-paths/register src/main.ts",
    "dev:jobs": "MICROSERVICE=jobs ts-node-dev --respawn --transpile-only --ignore-watch node_modules --project tsconfig.json -r tsconfig-paths/register src/main.ts",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "node scripts/lint.js",
    "lint:fix": "node scripts/lint.js --fix",
    "cache:purge:session-full": "node scripts/purge-session-full-cache.js",
    "pretype-check": "pnpm run build:deps",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --runInBand --coverage --ci",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:integration": "jest --config jest-integration.config.js",
    "test:integration:watch": "jest --config jest-integration.config.js --watch",
    "test:simulation": "jest --config jest.simulation.config.js --coverage",
    "test:e2e": "jest --config jest-e2e.config.js",
    "test:e2e:watch": "jest --config jest-e2e.config.js --watch",
    "test:all": "pnpm test && pnpm test:integration && pnpm test:e2e",
    "db:reset:all": "pnpm db:reset:userManagement && pnpm db:reset:simulation && pnpm db:reset:support && pnpm db:reset:analytics && pnpm db:reset:crm",
    "db:reset:userManagement": "prisma migrate reset --force --skip-seed --schema=./src/microservices/userManagement/prisma/schema.prisma",
    "db:reset:simulation": "prisma migrate reset --force --skip-seed --schema=./src/microservices/simulation/prisma/schema.prisma",
    "db:reset:support": "prisma migrate reset --force --skip-seed --schema=./src/microservices/support/prisma/schema.prisma",
    "db:reset:analytics": "prisma migrate reset --force --skip-seed --schema=./src/microservices/analytics/prisma/schema.prisma",
    "db:reset:crm": "prisma migrate reset --force --skip-seed --schema=./src/microservices/crm/prisma/schema.prisma",
    "db:generate:userManagement": "prisma generate --schema=./src/microservices/userManagement/prisma/schema.prisma",
    "db:generate:simulation": "prisma generate --schema=./src/microservices/simulation/prisma/schema.prisma",
    "db:generate:support": "prisma generate --schema=./src/microservices/support/prisma/schema.prisma",
    "db:generate:analytics": "prisma generate --schema=./src/microservices/analytics/prisma/schema.prisma",
    "db:generate:crm": "prisma generate --schema=./src/microservices/crm/prisma/schema.prisma",
    "db:generate:lti": "prisma generate --schema=./src/microservices/lti/prisma/schema.prisma",
    "db:generate:all": "pnpm run db:generate:userManagement && pnpm run db:generate:simulation && pnpm run db:generate:support && pnpm run db:generate:analytics && pnpm run db:generate:crm && pnpm run db:generate:lti",
    "db:seed": "pnpm run db:deploy:all && pnpm run db:generate:all && node scripts/seed-demo.js",
    "db:migrate:jobs": "echo 'Jobs microservice uses simulation DB — run db:migrate:simulation'",
    "db:migrate:lti": "prisma migrate dev --schema=./src/microservices/lti/prisma/schema.prisma",
    "db:migrate:userManagement": "prisma migrate dev --schema=./src/microservices/userManagement/prisma/schema.prisma",
    "db:migrate:simulation": "prisma migrate dev --schema=./src/microservices/simulation/prisma/schema.prisma",
    "db:migrate:support": "prisma migrate dev --schema=./src/microservices/support/prisma/schema.prisma",
    "db:migrate:analytics": "prisma migrate dev --schema=./src/microservices/analytics/prisma/schema.prisma",
    "db:migrate:crm": "prisma migrate dev --schema=./src/microservices/crm/prisma/schema.prisma",
    "db:migrate:all": "pnpm run db:migrate:userManagement && pnpm run db:migrate:simulation && pnpm run db:migrate:support && pnpm run db:migrate:analytics && pnpm run db:migrate:crm",
    "db:studio:userManagement": "prisma studio --schema=./src/microservices/userManagement/prisma/schema.prisma",
    "db:studio:simulation": "prisma studio --schema=./src/microservices/simulation/prisma/schema.prisma",
    "db:studio:support": "prisma studio --schema=./src/microservices/support/prisma/schema.prisma",
    "db:studio:analytics": "prisma studio --schema=./src/microservices/analytics/prisma/schema.prisma",
    "db:studio:crm": "prisma studio --schema=./src/microservices/crm/prisma/schema.prisma",
    "db:push:userManagement": "prisma db push --schema=./src/microservices/userManagement/prisma/schema.prisma",
    "db:push:simulation": "prisma db push --schema=./src/microservices/simulation/prisma/schema.prisma",
    "db:push:support": "prisma db push --schema=./src/microservices/support/prisma/schema.prisma",
    "db:push:analytics": "prisma db push --schema=./src/microservices/analytics/prisma/schema.prisma",
    "db:push:crm": "prisma db push --schema=./src/microservices/crm/prisma/schema.prisma",
    "db:push:lti": "prisma db push --schema=./src/microservices/lti/prisma/schema.prisma",
    "db:push:all": "pnpm run db:push:userManagement && pnpm run db:push:simulation && pnpm run db:push:support && pnpm run db:push:analytics && pnpm run db:push:crm && pnpm run db:push:lti",
    "db:deploy:userManagement": "prisma migrate deploy --schema=./src/microservices/userManagement/prisma/schema.prisma",
    "db:deploy:simulation": "prisma migrate deploy --schema=./src/microservices/simulation/prisma/schema.prisma",
    "db:deploy:support": "prisma migrate deploy --schema=./src/microservices/support/prisma/schema.prisma",
    "db:deploy:analytics": "prisma migrate deploy --schema=./src/microservices/analytics/prisma/schema.prisma",
    "db:deploy:crm": "prisma migrate deploy --schema=./src/microservices/crm/prisma/schema.prisma",
    "db:deploy:lti": "prisma db push --schema=./src/microservices/lti/prisma/schema.prisma --skip-generate",
    "db:deploy:all": "pnpm run db:deploy:userManagement && pnpm run db:deploy:simulation && pnpm run db:deploy:support && pnpm run db:deploy:analytics && pnpm run db:deploy:crm && pnpm run db:deploy:lti"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.993.0",
    "@aws-sdk/s3-request-presigner": "^3.993.0",
    "@elevenlabs/elevenlabs-js": "^2.33.0",
    "@langchain/core": "^0.3.80",
    "@langchain/langgraph": "^0.4.9",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.0.1",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.0.1",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/websockets": "^11.0.1",
    "@pitch/shared-backend": "workspace:*",
    "@prisma/client": "^6.19.0",
    "@prisma/extension-accelerate": "^2.0.2",
    "@trpc/server": "^11.8.1",
    "@types/passport-discord": "^0.1.14",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-linkedin-oauth2": "^1.5.6",
    "@types/passport-microsoft": "^2.1.0",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.4",
    "axios": "^1.7.9",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "langsmith": "^0.4.7",
    "mongoose": "8.19.4",
    "morgan": "^1.10.1",
    "nodemailer": "^7.0.13",
    "openai": "^4.96.0",
    "passport": "^0.7.0",
    "passport-discord": "^0.1.4",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-linkedin-oauth2": "^2.0.0",
    "passport-local": "^1.0.0",
    "passport-microsoft": "^2.1.0",
    "pdf-parse": "^2.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@faker-js/faker": "^10.0.0",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/amqplib": "^0.10.5",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.2.0",
    "prettier": "^3.4.2",
    "prisma": "^6.16.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "testcontainers": "^11.11.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0"
  }
}
