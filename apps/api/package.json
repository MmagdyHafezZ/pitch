{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --runInBand --coverage --ci",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:integration": "jest --config jest-integration.config.js",
    "test:integration:watch": "jest --config jest-integration.config.js --watch",
    "test:e2e": "jest --config jest-e2e.config.js",
    "test:e2e:watch": "jest --config jest-e2e.config.js --watch",
    "test:all": "pnpm test && pnpm test:integration && pnpm test:e2e",
    "db:generate:user": "cd src/microservices/user && prisma generate --schema=./prisma/schema.prisma",
    "db:migrate:user": "cd src/microservices/user && prisma migrate dev --schema=./prisma/schema.prisma",
    "db:generate:business": "cd src/microservices/business && prisma generate --schema=./prisma/schema.prisma",
    "db:migrate:business": "cd src/microservices/business && prisma migrate dev --schema=./prisma/schema.prisma",
    "db:generate:auth": "cd src/microservices/auth && prisma generate --schema=./prisma/schema.prisma",
    "db:migrate:auth": "cd src/microservices/auth && prisma migrate dev --schema=./prisma/schema.prisma",
    "db:generate:all": "npx prisma generate --schema=./prisma/schema.prisma && pnpm run db:generate:user && pnpm run db:generate:business && pnpm run db:generate:auth",
    "db:migrate:all": "pnpm run db:migrate:user && pnpm run db:migrate:business && pnpm run db:migrate:auth",
    "db:migrate-deploy:all": "pnpm run db:migrate:user -- --create-only && pnpm run db:migrate:business -- --create-only && pnpm run db:migrate:auth -- --create-only && prisma migrate deploy --schema=./src/microservices/user/prisma/schema.prisma && prisma migrate deploy --schema=./src/microservices/business/prisma/schema.prisma && prisma migrate deploy --schema=./src/microservices/auth/prisma/schema.prisma",
    "db:studio:user": "cd src/microservices/user && prisma studio --schema=./prisma/schema.prisma",
    "db:studio:business": "cd src/microservices/business && prisma studio --schema=./prisma/schema.prisma",
    "db:studio:auth": "cd src/microservices/auth && prisma studio --schema=./prisma/schema.prisma",
    "db:studio:all": "pnpm run db:studio:user && pnpm run db:studio:business && pnpm run db:studio:auth"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.16.2",
    "@trpc/server": "^11.4.4",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.4",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "compression": "^1.8.1",
    "dotenv": "^17.2.2",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@faker-js/faker": "^10.0.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/amqplib": "^0.10.5",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^6.16.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "^11.6.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
