# Database - Legacy (can be removed after migration)
DATABASE_URL="postgresql://username:password@localhost:5432/pitch_db"

# Prisma DB mode (accelerate, cloud, docker, local, direct)
DEP_MODE="local"

# Microservice Databases
USER_DATABASE_URL="postgresql://username:password@localhost:5432/pitch_users_db"
USER_DIRECT_URL="postgresql://username:password@localhost:5439/pitch_user"
SIMULATION_DATABASE_URL="postgresql://username:password@localhost:5432/pitch_simulation_db"
SIMULATION_DIRECT_URL="postgresql://username:password@localhost:5434/pitch_simulation"
SUPPORT_DATABASE_URL="postgresql://username:password@localhost:5432/pitch_support_db"
SUPPORT_DIRECT_URL="postgresql://username:password@localhost:5435/pitch_support"
ANALYTICS_DATABASE_URL="postgresql://username:password@localhost:5432/pitch_analytics_db"
ANALYTICS_DIRECT_URL="postgresql://username:password@localhost:5436/pitch_analytics"
CRM_DATABASE_URL="postgresql://username:password@localhost:5432/pitch_crm_db"
CRM_DIRECT_URL="postgresql://username:password@localhost:5437/pitch_crm"
BUSINESS_DATABASE_URL="postgresql://username:password@localhost:5432/pitch_business_db"
AUTH_DATABASE_URL="postgresql://username:password@localhost:5432/pitch_auth_db"

# RabbitMQ
RABBITMQ_URL="amqp://admin:admin123@localhost:5672"
# CloudAMQP (used when DEP_MODE=prod)
CLOUDAMQP_URL=""

# Redis
REDIS_URL="redis://localhost:6379"

# Server
PORT=8000

# Swagger
SWAGGER_TITLE="PITCH Microservices API"
SWAGGER_DESCRIPTION="Microservices REST API for PITCH application"
SWAGGER_VERSION="1.0.0"
SWAGGER_PATH="docs"
SWAGGER_SITE_TITLE="PITCH API Docs"

# Logging
MORGAN_FORMAT="combined"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-here"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-here"
JWT_REFRESH_EXPIRES_IN="7d"

# System Admin User Emails
SUPER_ADMIN_EMAILS=temp@gmail.com

# LLM catalog + pricing (Simulation service)
LLM_PRICING_CACHE_TTL_SECONDS=21600
LLM_MODEL_CATALOG_CACHE_TTL_SECONDS=21600

# OpenAI
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODELS_URL="https://api.openai.com/v1/models"
OPENAI_MODELS_AUTH_HEADER=""
OPENAI_PRICING_URL=""
OPENAI_PRICING_API_KEY=""
OPENAI_PRICING_AUTH_HEADER=""

# Watsonx
WATSONX_API_KEY=""
WATSONX_PROJECT_ID=""
WATSONX_URL="https://us-south.ml.cloud.ibm.com"
WATSONX_MODEL_SPECS_VERSION="2024-05-01"
WATSONX_MODEL_SPECS_URL=""
WATSONX_MODEL_SPECS_AUTH_HEADER=""
WATSONX_PRICING_URL=""
WATSONX_PRICING_API_KEY=""
WATSONX_PRICING_AUTH_HEADER=""

# Phone calling via Vapi transport
VAPI_API_KEY="your-vapi-api-key"
VAPI_PHONE_NUMBER_ID="your-vapi-phone-number-id"
PUBLIC_API_BASE_URL="https://your-public-api.example.com"
# Must be publicly reachable by Vapi; localhost/private IPs will not work.
# Optional: falls back to API_BASE_URL when omitted
VAPI_CONTEXT_SECRET="your-vapi-context-signing-secret"
# Optional: falls back to JWT_SECRET when omitted
# No Vapi hosted assistant ID is needed; phone calls send an inline assistant
# config that routes to the app's own LLM endpoint.
# Optional overrides
VAPI_BASE_URL="https://api.vapi.ai"
VAPI_CALL_URL=""

# Phone verification via SMS transport.
# Vapi handles calling; OTP SMS remains Twilio-backed for now.
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_FROM_NUMBER="+15551234567"
TWILIO_BASE_URL="https://api.twilio.com"
# Optional: if set, this secret is used instead of JWT_SECRET for local OTP hashing
PHONE_VERIFICATION_CODE_SECRET=""
PHONE_VERIFICATION_CODE_TTL_MINUTES="10"
PHONE_VERIFICATION_RESEND_COOLDOWN_SECONDS="30"
PHONE_VERIFICATION_MAX_ATTEMPTS="5"
PHONE_VERIFICATION_MAX_SENDS="3"

# =============================================================================
# LTI Service
# =============================================================================
LTI_DATABASE_URL="postgresql://username:password@localhost:5438/pitch_lti"
LTI_DIRECT_URL="postgresql://username:password@localhost:5438/pitch_lti"

# Generate with: node -e "const c=require('crypto');const{privateKey,publicKey}=c.generateKeyPairSync('rsa',{modulusLength:2048,publicKeyEncoding:{type:'spki',format:'pem'},privateKeyEncoding:{type:'pkcs8',format:'pem'}});console.log(Buffer.from(privateKey).toString('base64'));"
LTI_TOOL_PRIVATE_KEY=""

# The matching public JWKS — served at GET /api/v1/lti/v1.3/jwks
LTI_TOOL_PUBLIC_JWK='{"keys":[{"kty":"RSA","n":"...","e":"AQAB","kid":"pitch-lti-key-1","alg":"RS256","use":"sig"}]}'

# LTI 1.1 HMAC-SHA1 shared secret (dev fallback; per-consumer: LTI_SECRET_<KEY>=<secret>)
LTI_DEFAULT_CONSUMER_SECRET=""

# URLs used in LTI redirects
PITCH_APP_URL="http://localhost:3000"
API_BASE_URL="http://localhost:8000"
