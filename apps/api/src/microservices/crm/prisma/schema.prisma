// CRM Microservice - Prisma Schema
// This microservice manages external CRM integrations (Salesforce, HubSpot, etc.)

generator client {
  provider = "prisma-client-js"
  output   = "../../../../../../node_modules/@prisma/crm-client"
}

datasource db {
  provider  = "postgresql"
  url       = env("CRM_DATABASE_URL")
  directUrl = env("CRM_DIRECT_URL")
}

// Integration provider enum
enum IntegrationProvider {
  SALESFORCE
  HUBSPOT
}

// Integration status enum
enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  EXPIRED
}

// Integration - External CRM integrations (Salesforce, HubSpot, etc.)
// Stores OAuth tokens and connection metadata
model Integration {
  id       String              @id @default(cuid())
  userId   String              // User who connected this integration
  provider IntegrationProvider // SALESFORCE, HUBSPOT
  status   IntegrationStatus   @default(CONNECTED)

  // OAuth tokens
  accessToken  String? // OAuth access token
  refreshToken String? // OAuth refresh token
  expiresAt    DateTime? // Token expiration time
  instanceUrl  String? // Salesforce instance URL or HubSpot portal ID

  // Provider-specific data
  providerId    String? // User ID from the provider
  providerEmail String? // Email from the provider
  providerData  Json? // Additional provider-specific data

  // Metadata
  metadata  Json? // Additional configuration
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, provider])
  @@index([userId])
  @@index([provider])
  @@index([status])
  @@map("integrations")
}
