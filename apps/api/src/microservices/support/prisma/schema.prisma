generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("SUPPORT_DATABASE_URL")
}

//// ======================================
//// SUPPORT MICROSERVICE
//// ======================================

model FAQ {
  id          String   @id @default(cuid())
  question    String
  answer      String
  category    String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@map("faq")
}

model Documentation {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  section     String?
  content     String
  version     String?  // optional version tagging
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@map("documentation")
}

model ReleaseNote {
  id          String   @id @default(cuid())
  version     String
  title       String
  description String
  releasedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([version])
  @@map("release_notes")
}

model ChatBotInteraction {
  id          String   @id @default(cuid())
  userId      String?
  sessionId   String?
  message     String
  response    String?
  language    String?   // For multilingual support
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@index([sessionId])
  @@map("chatbot_interactions")
}

model EmailLog {
  id          String   @id @default(cuid())
  toEmail     String
  subject     String
  body        String
  sentAt      DateTime @default(now())
  status      String   @default("SENT") // SENT | FAILED | QUEUED
  teamMember  String?
  meetingLink String?
  createdAt   DateTime @default(now())

  @@index([toEmail])
  @@map("email_logs")
}

model SupportTicket {
  id          String   @id @default(cuid())
  userId      String?
  subject     String
  message     String
  status      String   @default("OPEN")     // OPEN | IN_PROGRESS | CLOSED
  priority    String   @default("NORMAL")   // LOW | NORMAL | HIGH
  assignedTo  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@index([status, priority])
  @@map("support_tickets")
}

//// ======================================
//// OPTIONAL: Shared reference to User (from User Management)
//// ======================================
model User {
  id    String  @id
  email String  @unique
  name  String?

  // Relations
  chatBotInteractions ChatBotInteraction[]
  supportTickets      SupportTicket[]

  @@map("users")
}
