// prisma/schema.prisma
// REFACTORED: Postgres stores relational spine only
// Large documents (transcripts, eval artifacts) moved to MongoDB
// Ephemeral data (sessions, signaling) uses Redis

generator client {
  provider = "prisma-client-js"
  output   = "../../../../../node_modules/@prisma/simulation-client"
}

datasource db {
  provider  = "postgresql"
   url       = env("SIMULATION_DATABASE_URL")
  directUrl = env("SIMULATION_DIRECT_URL")
}

/**
 * =================== Enums ===================
 */

enum SessionType {
  text
  voice
  video
  phone
}

enum SessionMemberRole {
  owner
  editor
  viewer
}

enum ScenarioVisibility {
  PRIVATE
  TEAM
  PUBLIC
}

enum TurnRole {
  user
  system
  assistant
  tool
}

enum EventType {
  simulation_started
  turn_completed
  simulation_completed
  recording_available
  stt_completed
  media_ingested
  analytics_updated
}

enum IngestPipeline {
  transcribe
  transcribe_enrich
  full
}

enum IngestStatus {
  queued
  running
  completed
  failed
}

enum RecordingLayout {
  grid
  speaker
  screen
}

enum ReportFormat {
  pdf
  json
}

enum AssessmentRunStatus {
  queued
  running
  completed
  failed
  cancelled
}

enum AssessmentLabelValue {
  // Placeholder labels - user might need to refine these
  PositiveExample
  NegativeExample
  Neutral
  ObjectiveMet
  ObjectiveNotMet
  InsightfulQuestion
  MissedOpportunity
}

enum AssessmentMode {
  live
  final
}

/**
 * =================== Orchestrator Core ===================
 */
/**
 * Users/Orgs are EXTERNAL. Store only opaque IDs + optional snapshots.
 */

model Session {
  id    String @id @default(cuid())
  orgId String

  // Session is now a shared resource
  name          String?
  type          SessionType
  tags          String[]
  sessionConfig Json?
  orgSnapshot   Json?

  scenarioId   String?
  scenario     Scenario? @relation(fields: [scenarioId], references: [id])
  personaId    String?
  persona      Persona?  @relation(fields: [personaId], references: [id])
  language     String?
  crmContextId String?
  status       String    @default("active") // active|ended
  endedReason  String?

  // Coin gating fields (set at session creation time)
  coinReservationId String?  // ID of the active coin reservation (from RESERVE ledger entry)
  coinPeriodKey     String?  // Billing period key (needed for coin.adjust event)
  estimatedCoins    Int?     // Coins reserved at session start (base cost from Plan)
  coinPriceUsd      Float?   // Snapshot of Plan.coinPriceUsd at session creation time

  // Multi-user access control
  members SessionMember[]
  iterations Iteration[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  endedAt       DateTime?

  @@index([orgId])
  @@index([status])
  @@index([scenarioId])
  @@index([personaId])
}

model SessionMember {
  id        String  @id @default(cuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  userId String
  role   SessionMemberRole @default(viewer)

  // User-specific data relations
  iterations Iteration[]

  // Denormalized user snapshot at join time
  userSnapshot Json?

  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, userId])
  @@index([userId])
  @@index([sessionId, role])
}

model Iteration {
  id              String        @id @default(cuid())
  sessionId       String
  session         Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionMemberId String
  sessionMember   SessionMember @relation(fields: [sessionMemberId], references: [id], onDelete: Cascade)
  iterationNumber Int
  status          String        @default("active") // active|completed
  endedReason     String?

  // Per-iteration snapshot of user data
  userSnapshot Json?

  turns          Turn[]
  events         Event[]
  metrics        Metric[]
  calls          CallSession[]
  scorecards     Scorecard[]
  drafts         DraftEmail[]
  messages       Message[]
  reportRequests ReportRequest[]
  evalArtifacts  EvalArtifact[]
  transcripts    Transcript[]
  mediaAssets    MediaAsset[]
  toolCalls      ToolCall[]
  assessmentRuns AssessmentRun[] @relation("IterationAssessmentRuns")

  startedAt DateTime @default(now())
  endedAt   DateTime?

  @@unique([sessionMemberId, iterationNumber])
  @@index([sessionId, sessionMemberId])
  @@index([status])
  @@index([sessionMemberId, startedAt])
}

// SessionInvitation moved to MongoDB

model Turn {
  id              String        @id @default(cuid())
  iterationId     String
  iteration       Iteration     @relation(fields: [iterationId], references: [id], onDelete: Cascade)
  role            TurnRole
  text            String?
  audioAssetId    String?
  attachments     Json? // AssetRef[] - small structured metadata
  metadata        Json? // small structured metadata only
  order           Int

  messages         Message[]
  toolCalls        ToolCall[]
  evalArtifacts    EvalArtifact[]
  assessmentLabels TurnAssessmentLabel[]

  createdAt DateTime @default(now())

  @@index([iterationId, order])
  @@index([role])
}

model Message {
  id              String        @id @default(cuid())
  iterationId     String
  iteration       Iteration     @relation(fields: [iterationId], references: [id], onDelete: Cascade)
  turnId          String?
  turn            Turn?         @relation(fields: [turnId], references: [id], onDelete: SetNull)
  role            TurnRole
  content         String? // Core text content only
  redaction       Json? // PII span annotations (small structured data)
  language        String?

  redactionSpans RedactionSpan[]

  createdAt DateTime @default(now())

  @@index([iterationId, turnId])
}

model ToolCall {
  id              String        @id @default(cuid())
  iterationId     String
  iteration       Iteration     @relation(fields: [iterationId], references: [id], onDelete: Cascade)
  turnId          String?
  turn            Turn?         @relation(fields: [turnId], references: [id], onDelete: SetNull)
  name            String
  input           Json // Small structured input
  output          Json? // Small structured output
  latencyMs       Int?
  success         Boolean?

  createdAt DateTime @default(now())

  @@index([iterationId, turnId, name])
}

model Event {
  id              String        @id @default(cuid())
  iterationId     String
  iteration       Iteration     @relation(fields: [iterationId], references: [id], onDelete: Cascade)
  type            EventType
  // SMALL payload only (< 1KB). For verbose payloads, use EventLog in MongoDB
  payload         Json?
  // Optional: reference to MongoDB EventLog document for large payloads
  mongoEventLogId String?

  createdAt DateTime @default(now())

  @@index([iterationId, type, createdAt])
}

model Metric {
  id              String        @id @default(cuid())
  iterationId     String
  iteration       Iteration     @relation(fields: [iterationId], references: [id], onDelete: Cascade)

  // One Metric row per session or per turn (define strict semantics)
  // Aggregate metrics for the session
  tokensInput  Int?
  tokensOutput Int?
  toolCount    Int?
  latencyMs    Int?
  costUsd      Float? // Total cost in USD for LLM/STT/TTS operations
  model        String?

  createdAt DateTime @default(now())

  @@index([iterationId, createdAt])
}

/**
 * =================== LLM Routing ===================
 */

model LlmRoutingConfig {
  id       String  @id @default(cuid())
  scope    String  @default("global") // global|org|user
  orgId    String?
  userId   String?
  name     String  @default("default")
  isActive Boolean @default(true)
  config   Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope, orgId, userId, isActive])
  @@index([name])
}

/**
 * Hint Generation Configuration
 * Stores LLM and strategy settings for hint generation
 */
model HintConfig {
  id       String  @id @default(cuid())
  scope    String  @default("global") // global|org|user|session
  orgId    String?
  userId   String?
  sessionId String?
  name     String  @default("default")
  isActive Boolean @default(true)

  // Hint generation settings
  enabled                    Boolean @default(true)
  strategy                   String  @default("reactive") // proactive|reactive|contextual
  maxHintsPerRequest         Int     @default(3)
  inactivityThresholdSeconds Int     @default(30)

  // LLM configuration for hint generation
  llmProvider  String? // If null, uses default routing
  llmModel     String? // If null, uses default routing
  temperature  Float?  @default(0.7)
  maxTokens    Int?    @default(500)

  // Additional configuration as JSON
  config Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope, orgId, userId, sessionId, isActive])
  @@index([name])
  @@index([sessionId])
}

/**
 * =================== Configuration (owned by this service) ===================
 */

model Scenario {
  id              String             @id @default(cuid())
  orgId           String // external
  createdByUserId String?
  visibility      ScenarioVisibility @default(PRIVATE)
  name            String
  description     String?
  config          Json? // Small structured config

  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([createdByUserId])
  @@index([visibility])
  @@index([orgId, visibility])
}

model Persona {
  id     String @id @default(cuid())
  orgId  String // external
  name   String
  traits Json? // Small structured traits

  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

/**
 * =================== Chat (text) ===================
 */

model DraftEmail {
  id              String        @id @default(cuid())
  iterationId     String
  iteration       Iteration     @relation(fields: [iterationId], references: [id], onDelete: Cascade)
  audience        String
  purpose         String
  tone            String?
  bullets         Json? // string[] - small array
  body            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([iterationId, createdAt])
}

/**
 * =================== Voice/Video ===================
 */

model CallSession {
  id              String        @id @default(cuid())
  iterationId     String
  iteration       Iteration     @relation(fields: [iterationId], references: [id], onDelete: Cascade)
  tracks          String[] // ["audio","video"]
  // Keep SDP offers/answers (small strings ~1-5KB)
  sdpOffer        String?
  sdpAnswer       String?
  status          String   @default("created") // created|active|ended

  recordings Recording[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Recording {
  id         String           @id @default(cuid())
  callId     String
  call       CallSession      @relation(fields: [callId], references: [id], onDelete: Cascade)
  layout     RecordingLayout?
  tracks     String[]
  assetId    String
  asset      MediaAsset       @relation(fields: [assetId], references: [id])
  durationMs Int?

  createdAt DateTime @default(now())

  @@index([callId, createdAt])
  @@index([assetId])
}

model MediaAsset {
  id                     String   @id @default(cuid())
  mimeType               String
  sizeBytes              BigInt
  storageKey             String // s3/minio key
  url                    String? // ephemeral pre-signed URL if needed
  ownerIterationId       String?
  ownerIteration         Iteration? @relation(fields: [ownerIterationId], references: [id], onDelete: SetNull)

  recordings    Recording[]
  transcripts   Transcript[]
  ingestionJobs IngestionJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storageKey])
}

/**
 * =================== Media Ingestion (batch) ===================
 */

model IngestionJob {
  id           String         @id @default(cuid())
  assetId      String
  asset        MediaAsset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  pipeline     IngestPipeline
  status       IngestStatus   @default(queued)
  error        String?
  transcriptId String? // FK to Transcript.id (stub)
  startedAt    DateTime?
  completedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId, status])
}

/**
 * =================== Transcripts (Stub in Postgres, Full Document in MongoDB) ===================
 */
// Postgres: Lightweight stub for indexing and foreign keys
// MongoDB: Full enriched transcript with segments, speakers, enrichment

model Transcript {
  id              String        @id @default(cuid())
  assetId         String
  asset           MediaAsset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  iterationId     String?
  iteration       Iteration?    @relation(fields: [iterationId], references: [id], onDelete: SetNull)
  language        String?

  // Keep aggregate text summary and metadata for quick access
  text     String? // Full text summary for search/preview
  metadata Json? // Small metadata (duration, speaker count, etc.)

  // MongoDB reference: EnrichedTranscript document with same ID
  // Contains: segments[], speakers[], enrichment{}

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId])
  @@index([iterationId])
  @@index([iterationId, createdAt])
}

/**
 * =================== Redactions & Evals ===================
 */

model RedactionSpan {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  spans     Json // [{start, end, label}] - small structured array

  createdAt DateTime @default(now())

  @@index([messageId])
}

model EvalArtifact {
  id              String        @id @default(cuid())
  iterationId     String
  iteration       Iteration     @relation(fields: [iterationId], references: [id], onDelete: Cascade)
  turnId          String?
  turn            Turn?         @relation(fields: [turnId], references: [id], onDelete: SetNull)
  kind            String // "prompt_eval" | "ragas" | "deepeval" | "llm_judge"
  score           Float?

  // MongoDB reference: EvalArtifactData document with same ID
  // Contains: full evaluation artifact, reasoning traces, detailed metrics

  createdAt DateTime @default(now())

  @@index([iterationId, kind])
  @@index([turnId])
}

/**
 * =================== RAG: pgvector in Postgres ===================
 */

model EmbeddingRow {
  id        String                @id @default(cuid())
  // Actual vector column added via SQL migration (e.g., vector(1536))
  embedding Unsupported("vector")
  namespace String // "kb" | "transcript" | "previous_calls"
  refType   String // "TranscriptSegment" | "Doc" | "Message"
  refId     String
  metadata  Json? // Small structured metadata

  createdAt DateTime @default(now())

  @@index([namespace])
  @@index([refType, refId])
}

/**
 * =================== Feedback Engine ===================
 */

model Rubric {
  id      String @id @default(cuid())
  orgId   String
  name    String
  version Int    @default(1)

  criteria   Criterion[]
  scorecards Scorecard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, name, version])
  @@index([orgId])
}

model Criterion {
  id        String @id @default(cuid())
  rubricId  String
  rubric    Rubric @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  label     String
  maxPoints Int // Source of truth for max points
  weight    Float?
  order     Int

  scoreItems ScoreItem[]

  createdAt DateTime @default(now())

  @@index([rubricId, order])
}

model Scorecard {
  id              String        @id @default(cuid())
  iterationId     String
  iteration       Iteration     @relation(fields: [iterationId], references: [id], onDelete: Cascade)
  rubricId        String?
  rubric          Rubric?       @relation(fields: [rubricId], references: [id], onDelete: SetNull)
  totalScore      Float?
  maxScore        Float?
  locale          String?

  items     ScoreItem[]
  coachTips CoachTip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([iterationId])
  @@index([rubricId])
}

model ScoreItem {
  id          String     @id @default(cuid())
  scorecardId String
  scorecard   Scorecard  @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  criterionId String?
  criterion   Criterion? @relation(fields: [criterionId], references: [id], onDelete: SetNull)
  score       Float?
  // REMOVED: maxPoints (redundant, derive from criterion.maxPoints via JOIN)
  details     Json? // Small structured feedback

  createdAt DateTime @default(now())

  @@index([scorecardId])
  @@index([criterionId])
}

model CoachTip {
  id          String    @id @default(cuid())
  scorecardId String
  scorecard   Scorecard @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  text        String
  link        String?
  excerptRef  String? // Points to Message/Transcript/Doc id

  createdAt DateTime @default(now())

  @@index([scorecardId])
}

model Benchmark {
  id     String  @id @default(cuid())
  orgId  String
  // Clarified semantics:
  // name: dimension/category (e.g., "objection_handling", "product_knowledge")
  // metric: measurement type (e.g., "avg_score", "p95_latency", "completion_rate")
  name   String
  metric String
  value  Float
  window String? // Time window: "7d", "30d", "all_time"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, name])
  @@index([orgId, metric])
}

/**
 * =================== Assessment Engine ===================
 */

model AssessmentRun {
  id              String        @id @default(cuid())
  iterationId     String
  iteration       Iteration     @relation("IterationAssessmentRuns", fields: [iterationId], references: [id], onDelete: Cascade)

  status        AssessmentRunStatus @default(queued)
  mode          AssessmentMode
  inputHash     String?             @unique // Deterministic hash of inputs for idempotency
  config        Json // Snapshot of AssessmentConfig used for this run
  engineVersion String? // e.g., "langgraph-v1.2"

  // Denormalized fields for quick access/filtering
  totalScore  Float?
  startedAt   DateTime?
  completedAt DateTime?

  // Relations
  labels  TurnAssessmentLabel[]
  summary AssessmentSummary?

  // MongoDB reference for the full, verbose report artifact
  // The document in the 'assessment_reports' collection will have `runId: this.id`
  mongoReportId String? @unique // Storing the ID is optional but good practice

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([iterationId, status])
  @@index([iterationId, createdAt(sort: Desc)])
}

model TurnAssessmentLabel {
  id              String        @id @default(cuid())
  assessmentRunId String
  assessmentRun   AssessmentRun @relation(fields: [assessmentRunId], references: [id], onDelete: Cascade)

  turnId String // Reference to the Turn.id this label applies to
  turn   Turn   @relation(fields: [turnId], references: [id], onDelete: Cascade)

  label      AssessmentLabelValue
  confidence Float? // 0.0 to 1.0 confidence score from the judge
  scoreDelta Float? // The score change applied based on this label
  evidence   String? @db.Text // Excerpt from the turn text as evidence

  // To handle multi-judge scenarios or conflicting labels
  isFinal Boolean @default(true) // False if this is a provisional label from a single judge in a multi-judge setup

  createdAt DateTime @default(now())

  @@index([assessmentRunId])
  @@index([turnId])
  @@index([label])
}

model AssessmentSummary {
  id              String      @id @default(cuid())
  assessmentRunId String      @unique
  assessmentRun   AssessmentRun @relation(fields: [assessmentRunId], references: [id], onDelete: Cascade)

  // Aggregate scores and metrics
  totalScore Float

  // Could also include histograms or breakdowns as JSON
  // e.g., labelCounts: { "InsightfulQuestion": 3, "MissedOpportunity": 1 }
  scoreBreakdown Json?

  // Qualitative summary generated by the LLM
  narrativeSummary String? @db.Text
  coachTips        Json? // CoachTip[] - structured coaching advice

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * =================== Public Challenges ===================
 */

enum ChallengePeriod {
  DAILY
  WEEKLY
  MONTHLY
}

enum ChallengeDifficulty {
  BEGINNER
  INTERMEDIATE
  EXPERT
  MASTER
}

enum ChallengeStatus {
  UPCOMING
  ACTIVE
  EXPIRED
}

model Challenge {
  id                     String              @id @default(cuid())
  period                 ChallengePeriod
  difficulty             ChallengeDifficulty
  status                 ChallengeStatus     @default(UPCOMING)
  title                  String
  description            String
  topic                  String
  scenarioPrompt         String              @db.Text
  evaluatorPersonaPrompt String              @db.Text
  startsAt               DateTime
  expiresAt              DateTime
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  participations ChallengeParticipation[]

  @@index([status, period])
  @@index([startsAt, expiresAt])
}

model ChallengeParticipation {
  id          String     @id @default(cuid())
  challengeId String
  challenge   Challenge  @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  sessionId   String?
  score       Float?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([challengeId, userId])
  @@index([userId])
  @@index([challengeId, score])
}

/**
 * =================== Reports ===================
 */

model ReportRequest {
  id              String        @id @default(cuid())
  iterationId     String
  iteration       Iteration     @relation(fields: [iterationId], references: [id], onDelete: Cascade)
  format          ReportFormat
  status          String        @default("queued") // queued|ready|failed
  assetId         String? // MediaAsset holding produced PDF/JSON
  error           String?

  // MongoDB reference: ReportSnapshot document with same ID (for JSON format)
  // Contains: full structured report data

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([iterationId, format, status])
}
