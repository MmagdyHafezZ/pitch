{
  "name": "PITCH",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "type-check": "turbo run type-check",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "check": "node scripts/check.js",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:ci": "turbo run test:ci",
    "test:cov": "pnpm --filter api test:cov",
    "test:coverage": "pnpm --filter web test:coverage",
    "test:all": "pnpm --filter api test:all",
    "prepare": "husky install",
    "pre-commit": "lint-staged",
    "commit": "cz",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "dev:gateway": "pnpm --filter api dev:gateway",
    "dev:user": "pnpm --filter api dev:user",
    "dev:simulation": "pnpm --filter api dev:simulation",
    "dev:support": "pnpm --filter api dev:support",
    "dev:analytics": "pnpm --filter api dev:analytics",
    "dev:lti": "pnpm --filter api dev:lti",
    "dev:s3": "pnpm --filter api dev:s3",
    "dev:crm": "pnpm --filter api dev:crm",
    "build:api": "pnpm --filter api build",
    "build:web": "pnpm --filter web build",
    "start:api": "pnpm --filter api start",
    "start:api:prod": "pnpm --filter api start:prod",
    "start:api:debug": "pnpm --filter api start:debug",
    "start:web": "pnpm --filter web start",
    "test:api": "pnpm --filter api test",
    "test:web": "pnpm --filter web test",
    "test:api:watch": "pnpm --filter api test:watch",
    "test:web:watch": "pnpm --filter web test:watch",
    "test:api:integration": "pnpm --filter api test:integration",
    "test:api:integration:watch": "pnpm --filter api test:integration:watch",
    "test:api:e2e": "pnpm --filter api test:e2e",
    "test:api:e2e:watch": "pnpm --filter api test:e2e:watch",
    "test:api:debug": "pnpm --filter api test:debug",
    "lint:api": "pnpm --filter api lint",
    "lint:web": "pnpm --filter web lint",
    "lint:api:fix": "pnpm --filter api lint:fix",
    "lint:web:fix": "pnpm --filter web lint:fix",
    "type-check:api": "pnpm --filter api type-check",
    "type-check:web": "pnpm --filter web type-check",
    "format:api": "pnpm --filter api format",
    "format:web": "pnpm --filter web format",
    "format:api:check": "pnpm --filter api format:check",
    "format:web:check": "pnpm --filter web format:check",
    "db:generate:all": "pnpm --filter api db:generate:all",
    "db:generate:userManagement": "pnpm --filter api db:generate:userManagement",
    "db:generate:simulation": "pnpm --filter api db:generate:simulation",
    "db:generate:support": "pnpm --filter api db:generate:support",
    "db:generate:analytics": "pnpm --filter api db:generate:analytics",
    "db:generate:crm": "pnpm --filter api db:generate:crm",
    "db:migrate:all": "pnpm --filter api db:migrate:all",
    "db:migrate:userManagement": "pnpm --filter api db:migrate:userManagement",
    "db:migrate:simulation": "pnpm --filter api db:migrate:simulation",
    "db:migrate:support": "pnpm --filter api db:migrate:support",
    "db:migrate:analytics": "pnpm --filter api db:migrate:analytics",
    "db:migrate:crm": "pnpm --filter api db:migrate:crm",
    "db:push:all": "pnpm --filter api db:push:all",
    "db:push:userManagement": "pnpm --filter api db:push:userManagement",
    "db:push:simulation": "pnpm --filter api db:push:simulation",
    "db:push:support": "pnpm --filter api db:push:support",
    "db:push:analytics": "pnpm --filter api db:push:analytics",
    "db:push:crm": "pnpm --filter api db:push:crm",
    "db:studio:userManagement": "pnpm --filter api db:studio:userManagement",
    "db:studio:simulation": "pnpm --filter api db:studio:simulation",
    "db:studio:support": "pnpm --filter api db:studio:support",
    "db:studio:analytics": "pnpm --filter api db:studio:analytics",
    "db:studio:crm": "pnpm --filter api db:studio:crm",
    "db:reset:all": "pnpm --filter api db:reset:all",
    "db:reset:userManagement": "pnpm --filter api db:reset:userManagement",
    "db:reset:simulation": "pnpm --filter api db:reset:simulation",
    "db:reset:support": "pnpm --filter api db:reset:support",
    "db:reset:analytics": "pnpm --filter api db:reset:analytics",
    "db:reset:crm": "pnpm --filter api db:reset:crm",
    "db:deploy:all": "pnpm --filter api db:deploy:all",
    "db:deploy:userManagement": "pnpm --filter api db:deploy:userManagement",
    "db:deploy:simulation": "pnpm --filter api db:deploy:simulation",
    "db:deploy:support": "pnpm --filter api db:deploy:support",
    "db:deploy:analytics": "pnpm --filter api db:deploy:analytics",
    "db:deploy:crm": "pnpm --filter api db:deploy:crm",
    "docker:build": "bash ./scripts/docker-build-all.sh",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:ps": "docker-compose ps",
    "docker:restart": "docker-compose restart",
    "docker:clean": "docker-compose down -v",
    "secrets:allow": "python3 scripts/secrets_allow.py",
    "compile:architecture": "cd docs/architecture/MicroServices && node compile-architecture.js",
    "diagrams:convert": "node scripts/mermaid-to-png.js",
    "diagrams:simulation": "bash scripts/convert-mermaid.sh --simulation",
    "diagrams:user": "bash scripts/convert-mermaid.sh --user",
    "diagrams:support": "bash scripts/convert-mermaid.sh --support",
    "diagrams:all": "pnpm run diagrams:simulation && pnpm run diagrams:user && pnpm run diagrams:support"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.17.1",
  "resolutions": {
    "tmp": "^0.2.4"
  },
  "pnpm": {
    "overrides": {
      "@langchain/azure-openai>@langchain/core": "0.3.80",
      "diff": "4.0.4",
      "js-yaml": "4.1.1",
      "jsonwebtoken@9.0.2": "9.0.3",
      "lodash": "4.17.23"
    }
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.3",
    "@types/node": "^24.10.1",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv": "^17.2.2",
    "husky": "^8.0.3",
    "lint-staged": "^15.5.2",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.3.11",
    "@langchain/azure-openai": "^0.0.11",
    "@langchain/cohere": "^1.0.1",
    "@langchain/community": "^1.1.6",
    "@langchain/core": "^0.3.80",
    "@langchain/google-genai": "^2.1.12",
    "@langchain/langgraph": "^0.4.9",
    "@langchain/openai": "^1.2.3",
    "langsmith": "^0.4.8",
    "tiktoken": "^1.0.22",
    "zod": "^4.1.12"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "docs/architecture/MicroServices/*/architecture.mmd": [
      "npm run compile:architecture",
      "git add docs/architecture/MicroServices/overall-architecture.mmd"
    ]
  }
}
