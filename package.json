{
  "name": "PITCH",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "private": true,
  "workspaces": [
    "apps/I*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "prisma:generate": "turbo run db:migrate:all --filter=api",
    "dev:api": "turbo run dev --filter=api",
    "dev:web": "turbo run dev --filter=web",
    "db:migrate:all": "turbo run db:migrate:all",
    "db:generate:all": "turbo run db:generate:all",
    "build": "turbo run build",
    "secrets:allow": "python3 scripts/secrets_allow.py",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:ci": "turbo run test -- --ci --coverage",
    "type-check": "turbo run type-check",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "prepare": "husky install",
    "pre-commit": "lint-staged",
    "commit": "cz",
    "compile:architecture": "cd docs/architecture/MicroServices && node compile-architecture.js",
    "diagrams:convert": "node scripts/mermaid-to-png.js",
    "diagrams:simulation": "bash scripts/convert-mermaid.sh --simulation",
    "diagrams:user": "bash scripts/convert-mermaid.sh --user",
    "diagrams:support": "bash scripts/convert-mermaid.sh --support",
    "diagrams:all": "pnpm run diagrams:simulation && pnpm run diagrams:user && pnpm run diagrams:support"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.17.1",
  "resolutions": {
    "tmp": "^0.2.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.3",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.5.2",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "docs/architecture/MicroServices/*/architecture.mmd": [
      "npm run compile:architecture",
      "git add docs/architecture/MicroServices/overall-architecture.mmd"
    ]
  }
}
