%% ===========================
%% INTERNAL FLOWS
%% ===========================

%% Gateways to Controllers
FAQGW --> FAQCtrl
DocsGW --> DocsCtrl
ContactGW --> ContactCtrl
ChatGW --> ChatCtrl
RelGW --> RelCtrl
EmailGW --> EmailCtrl

%% Controllers to Services
FAQCtrl --> FAQSvc
DocsCtrl --> DocsSvc
ContactCtrl --> ContactSvc
ChatCtrl --> ChatSvc
RelCtrl --> RelSvc
EmailCtrl --> EmailSvc

%% Services to Repositories
FAQSvc --> FAQRepo
DocsSvc --> DocsRepo
RelSvc --> RelRepo
EmailSvc --> EmailRepo
ChatSvc --> ChatRepo

%% Repositories to Tables
FAQRepo --> FAQTable
DocsRepo --> DocsTable
RelRepo --> RelTable
EmailRepo --> EmailTable
ChatRepo --> ChatTable

%% ===========================
%% CROSS-SERVICE INTERACTIONS
%% ===========================
ContactSvc --> ChatSvc
ChatSvc -->|AI Engine Requests| AIEngine[(AI Engine)]
EmailSvc -->|Send Meeting Request| NotificationQueue[(Notification Queue / SMTP Service)]

