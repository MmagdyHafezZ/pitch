classDiagram
class SessionController {
  +start(dto: StartSessionDto): SimulationSession
  +get(id: string): SimulationSession
  +end(id: string, dto: EndSessionDto): void
}
class TurnController {
  +advance(id: string, dto: AdvanceTurnDto): TurnResult
  +list(id: string): Turn[]
}
class ToolController {
  +invoke(id: string, dto: ToolCallDto): ToolCall
}

class OrchestratorService {
  +startSession(dto: StartSessionDto): SimulationSession
  +advanceTurn(sessionId: string, dto: AdvanceTurnDto): TurnResult
  +endSession(sessionId: string, reason?: string): void
}

class GraphRunner {
  +runStep(ctx: GraphContext): StepResult
  +routeTool(call: ToolCall): any
}

class ContextService {
  +assemble(sessionId: string): Context
  +persistSnapshot(sessionId: string, ctx: Context): void
}

class ToolRouter {
  +callRag(query: string): string[]
  +callDraftEmail(input: any): any
  +callStt(assetId: string): any
  +callTts(text: string): AssetRef
}

class GuardrailService {
  +redact(text: string): Redaction
  +validate<T>(data: any, schema: any): T
}

class MetricService {
  +record(sessionId: string, name: string, value: number): void
}

class SimulationSession {
  +id: string
  +orgId: string
  +userId: string
  +mode: string
  +status: string
  +startedAt: Date
  +endedAt: Date
}

class Turn {
  +id: string
  +sessionId: string
  +role: string
  +text: string
  +audioAssetId: string
  +latencyMs: number
  +createdAt: Date
}

class Message {
  +id: string
  +turnId: string
  +content: string
  +tokensIn: number
  +tokensOut: number
}

class ToolCall {
  +id: string
  +turnId: string
  +name: string
  +input: json
  +output: json
}

SessionController --> OrchestratorService
TurnController --> OrchestratorService
ToolController --> OrchestratorService
OrchestratorService --> GraphRunner
OrchestratorService --> ContextService
OrchestratorService --> GuardrailService
OrchestratorService --> MetricService
GraphRunner --> ToolRouter
OrchestratorService --> SimulationSession
OrchestratorService --> Turn
Turn --> Message
Turn --> ToolCall
