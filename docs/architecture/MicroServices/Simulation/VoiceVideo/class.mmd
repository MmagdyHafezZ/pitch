classDiagram
class CallController {
  +create(dto: CreateCallDto): CallSession
  +sdp(callId: string, dto: SdpDto): void
  +ice(callId: string, dto: IceDto): void
  +startRecording(dto: StartRecordingDto): Recording
  +stopRecording(callId: string): void
}

class MediaController {
  +uploadInit(dto: UploadInitDto): {assetId: string, url: string}
  +uploadPart(dto: UploadPartDto): void
  +complete(assetId: string): MediaAsset
}

class WebRTCService {
  +handleSdp(callId: string, sdp: string): void
  +handleIce(callId: string, cand: string): void
}

class STTService {
  +transcribe(assetId: string): TranscriptRef
  +streaming(callId: string, trackId: string): PartialTranscriptStream
}

class TTSService {
  +synthesize(text: string, voice: string): MediaAsset
}

class RecordingService {
  +start(callId: string, layout?: string): Recording
  +stop(callId: string): void
}

class CallSession {
  +id: string
  +sessionId: string
  +status: string
  +createdAt: Date
}

class Recording {
  +id: string
  +callId: string
  +assetId: string
  +createdAt: Date
}

class MediaAsset {
  +id: string
  +bucket: string
  +key: string
  +mimeType: string
  +sizeBytes: number
}

CallController --> WebRTCService
CallController --> RecordingService
CallController --> STTService
CallController --> TTSService
MediaController --> MediaAsset
RecordingService --> Recording
Recording --> MediaAsset
