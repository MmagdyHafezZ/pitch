flowchart TB
    %% S3 Manager Microservice
    subgraph S3Manager["S3 Manager Microservice"]
        
        %% API Gateways
        subgraph API["API Gateway"]
            S3Gateway["S3 Gateway"]
        end
        
        %% Controllers
        subgraph CTRL["Controllers"]
            BucketController["BucketController"]
            FileController["FileController"]
        end
        
        %% Services
        subgraph SVC["Services"]
            BucketService["BucketService"]
            FileService["FileService"]
        end
        
        %% Repositories
        subgraph REPO["Repositories (Optional)"]
            S3Repository["S3Repository<br/>Wrapper for AWS SDK S3 calls"]
        end
        
        %% Tables
        subgraph Table["Tables"]
            None["No Tables<br/>All data stored directly in S3 buckets"]
        end
    end
    
    %% External Connections
    EnvVars["Environment Variables<br/>AWS_REGION, S3_BUCKET_MAIN, S3_BUCKET_BACKUP"]
    AWS["AWS S3<br/>(Buckets and Objects)"]
    
    %% Internal Flows
    S3Gateway --> BucketController
    S3Gateway --> FileController
    
    BucketController --> BucketService
    FileController --> FileService
    
    BucketService --> S3Repository
    FileService --> S3Repository
    
    S3Repository --> AWS
    
    S3Manager -.-> EnvVars
