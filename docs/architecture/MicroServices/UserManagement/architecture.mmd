---
config:
  theme: base
  themeVariables:
    primaryColor: '#e3f2fd'
    primaryTextColor: '#1a237e'
    primaryBorderColor: '#1976d2'
    lineColor: '#42a5f5'
    secondaryColor: '#fff3e0'
    secondaryTextColor: '#e65100'
    secondaryBorderColor: '#fb8c00'
    tertiaryColor: '#f3e5f5'
    tertiaryTextColor: '#4a148c'
    tertiaryBorderColor: '#7b1fa2'
    noteBkgColor: '#fff9c4'
    noteTextColor: '#f57f17'
---
flowchart TB
 subgraph API["API Gateways"]
        AuthGW["Auth Gateway"]
        UserGW["User Gateway"]
        OrgGW["Org Gateway"]
        PlanGW["Plan Gateway"]
        SubGW["Subscription Gateway"]
        QuotaGW["Usage Gateway"]
  end
 subgraph CTRL["Controllers"]
        AuthCtrl["Auth Controller"]
        UserCtrl["User Controller"]
        OrgCtrl["Org Controller"]
        PlanCtrl["Plan Controller"]
        SubCtrl["Subscription Controller"]
        QuotaCtrl["Usage Controller"]
  end
 subgraph SVC["Services"]
        AuthSvc["Auth Service"]
        UserSvc["User Service"]
        OrgSvc["Org Service"]
        PlanSvc["Plan Service"]
        SubSvc["Subscription Service"]
        QuotaSvc["Usage Service"]
  end
 subgraph REPO["Repositories"]
        UserRepo["User Repository"]
        OrgRepo["Org Repository"]
        PlanRepo["Plan Repository"]
        SubRepo["Subscription Repository"]
        QuotaRepo["UsageRecord Repository"]
  end
 subgraph Table["Tables"]
        UserTable[("User Table<br>")]
        OrgTable[("Org Details Table<br>")]
        MembershipTable[("Membership Table<br>")]
        PlanTable[("Plan Table<br>")]
        SubTable[("Subscription Table<br>")]
        QuotaTable[("UsageRecord Table")]
  end
 subgraph UserManagement["UserManagement Microservice"]
        API
        CTRL
        SVC
        REPO
        Table
  end
    AuthGW --> AuthCtrl
    AuthCtrl --> AuthSvc
    AuthSvc --> UserRepo
    UserRepo --> UserTable
    UserGW --> UserCtrl
    UserCtrl --> UserSvc
    UserSvc --> UserRepo
    OrgGW --> OrgCtrl
    OrgCtrl --> OrgSvc
    OrgSvc --> OrgRepo
    OrgRepo --> OrgTable & MembershipTable
    PlanGW --> PlanCtrl
    PlanCtrl --> PlanSvc
    PlanSvc --> PlanRepo
    PlanRepo --> PlanTable
    SubGW --> SubCtrl
    SubCtrl --> SubSvc
    SubSvc --> SubRepo
    SubRepo --> SubTable
    QuotaGW --> QuotaCtrl
    QuotaCtrl --> QuotaSvc
    QuotaSvc --> QuotaRepo
    QuotaRepo --> QuotaTable
