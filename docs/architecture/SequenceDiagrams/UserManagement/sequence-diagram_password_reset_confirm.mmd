sequenceDiagram
    autonumber
    actor U as User
    participant AG as Auth Gateway
    participant AC as Auth Controller
    participant AS as Auth Service
    participant RTRS as ResetToken Repo
    participant UR as User Repo
    participant RTR as RefreshToken Repo
    participant DB as Database

    U->>AG: POST /auth/password/reset/confirm {token,newPassword}
    AG->>AC: forward
    AC->>AS: confirmPasswordReset(token,newPassword)

    %% Validate token
    AS->>RTRS: getByToken(token)
    RTRS->>DB: SELECT reset_tokens WHERE token=?
    DB-->>RTRS: tokenRow?
    RTRS-->>AS: tokenRow?

    alt token missing | expired | revoked
        AS-->>AC: 400/410 invalid token
        AC-->>AG: error
        AG-->>U: error
    else valid
        %% Update password
        AS->>UR: getUserById(tokenRow.userId)
        UR->>DB: SELECT users WHERE id=?
        DB-->>UR: user
        UR-->>AS: user
        AS->>AS: hash = hash(newPassword)
        AS->>UR: updatePassword(user.id, hash)
        UR->>DB: UPDATE users SET passwordHash=?
        DB-->>UR: ok
        UR-->>AS: ok

        %% Revoke the reset token and old refresh tokens
        AS->>RTRS: revoke(tokenRow.id, revokedAt=now())
        RTRS->>DB: UPDATE reset_tokens SET revokedAt=now() WHERE id=?
        DB-->>RTRS: ok
        RTRS-->>AS: ok

        AS->>RTR: revokeAll(user.id)
        RTR->>DB: UPDATE refresh_tokens SET revokedAt=now() WHERE userId=?
        DB-->>RTR: ok
        RTR-->>AS: ok

        %% Issue fresh session (optional)
        AS-->>AC: issue accessJWT{userId:user.id}
        AC->>RTR: insert refresh_token{userId,expiresAt}
        RTR->>DB: INSERT refresh_tokens(...)
        DB-->>RTR: ok
        RTR-->>AC: refreshToken

        AC-->>AG: 200 {accessJWT, refreshToken}
        AG-->>U: success
    end
