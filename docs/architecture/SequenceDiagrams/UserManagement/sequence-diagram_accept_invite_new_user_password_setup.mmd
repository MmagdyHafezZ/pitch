sequenceDiagram
    autonumber
    actor Invitee as Invitee Client
    participant AG as Auth Gateway
    participant AC as Auth Controller
    participant AS as Auth Service
    participant TS as Team Service
    participant UR as User Repo
    participant TMR as TeamMembership Repo
    participant ITR as InviteToken Repo
    participant RTR as RefreshToken Repo
    participant ES as Email Service
    participant DB as Database

    %% 0) Open invite
    Invitee->>AG: GET /invites/{token}
    AG->>AS: validateInvite(token)
    AS->>ITR: findByToken(token)
    ITR->>DB: SELECT invite_tokens WHERE token=?
    DB-->>ITR: invite{teamId,email,role,status,expiresAt,userId?}
    ITR-->>AS: invite
    AS-->>AG: 200 {teamId,email,role,status}
    AG-->>Invitee: show accept form (name,password)

    %% 1) Accept invite as NEW USER
    Invitee->>AG: POST /invites/{token}/accept {name,password}
    AG->>AC: forward
    AC->>AS: acceptInviteNewUser(token,name,password)

    %% Guardrails
    AS->>ITR: get(token)
    ITR->>DB: SELECT invite_tokens
    DB-->>ITR: invite
    ITR-->>AS: invite
    alt invite invalid | expired | not PENDING
        AS-->>AC: 400/410/409 error
        AC-->>AG: error
        AG-->>Invitee: cannot accept
    else valid
        %% Ensure email not already registered
        AS->>UR: findByEmail(invite.email)
        UR->>DB: SELECT users WHERE email=?
        DB-->>UR: null
        UR-->>AS: null

        %% Create user (inactive=false since invite is proof)
        AS->>AS: hash = hash(password)
        AS->>UR: insertUser({email:invite.email, name, hash, isActive:true})
        UR->>DB: INSERT users(...)
        DB-->>UR: user{id,email}
        UR-->>AS: user

        %% Create TeamMembership
        AS->>TMR: create({userId:user.id, teamId:invite.teamId, role:invite.role, isActive:true, invitedAt, acceptedAt:now()})
        TMR->>DB: INSERT team_memberships(...)
        DB-->>TMR: membership{id}
        TMR-->>AS: membership

        %% Mark invite accepted and bind userId
        AS->>ITR: update(invite.id,{status:"ACCEPTED", userId:user.id, acceptedAt:now()})
        ITR->>DB: UPDATE invite_tokens SET ...
        DB-->>ITR: ok
        ITR-->>AS: ok

        %% Issue tokens
        AS-->>AC: issue accessJWT
        AC->>RTR: insert refresh_token{userId,expiresAt}
        RTR->>DB: INSERT refresh_tokens(...)
        DB-->>RTR: ok
        RTR-->>AC: refreshToken
        AC-->>AG: 200 {accessJWT, refreshToken, teamId}

        %% Optional welcome email
        AS->>ES: sendWelcome(invite.email, teamId)
        ES-->>AS: accepted

        AG-->>Invitee: authenticated + joined team
    end

    %% Note: if user already exists → handle via point 4 (existing user accept)
