sequenceDiagram
    autonumber
    actor U as User
    participant AG as Auth Gateway
    participant AC as Auth Controller
    participant AS as Auth Service
    participant UR as User Repo
    participant RTRS as ResetToken Repo
    participant ES as Email Service
    participant DB as Database

    U->>AG: POST /auth/password/reset/request {email}
    AG->>AC: forward
    AC->>AS: requestPasswordReset(email)

    AS->>UR: findByEmail(email)
    UR->>DB: SELECT users WHERE email=?
    DB-->>UR: user? 
    UR-->>AS: user?

    alt user not found
        %% Respond 202 to avoid user enumeration
        AS-->>AC: 202 accepted (no-op)
        AC-->>AG: 202
        AG-->>U: 202 check your email
    else user exists
        %% Invalidate prior tokens (optional)
        AS->>RTRS: revokeAll(user.id)
        RTRS->>DB: UPDATE reset_tokens SET revokedAt=now() WHERE userId=?
        DB-->>RTRS: ok
        RTRS-->>AS: ok

        %% Create reset token
        AS->>RTRS: create({userId:user.id, expiresAt})
        RTRS->>DB: INSERT reset_tokens(...)
        DB-->>RTRS: {id, token}
        RTRS-->>AS: token

        %% Send email
        AS->>ES: sendPasswordReset(email, link(token))
        ES-->>AS: accepted

        AS-->>AC: 202 accepted
        AC-->>AG: 202
        AG-->>U: 202 check your email
    end
