flowchart LR
    ChatCtrl["Chat Controller"] -->|"toolCall {name, args}"| Orch["Orchestrator Svc"]

    Orch -->|"INSERT pending {toolName, args}"| ToolRepo["ToolCall Repo"]
    ToolRepo --> PG["Postgres"]

    Orch -->|"exec & result {output}"| ChatCtrl

    ChatCtrl -->|"UPDATE success {result}"| ToolRepo
    ToolRepo --> PG

    ChatCtrl -->|"append assistant message {summary, artifacts}"| MsgRepo["Message Repo"]
    MsgRepo --> PG

    Orch -.->|"publish simulation.tool.completed {toolId}"| MQ[(RabbitMQ)]
