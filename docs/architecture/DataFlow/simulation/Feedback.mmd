flowchart LR
    Client["Client"] -->|"POST /feedback {sessionId, answers[]}"| FBGW["Feedback GW"]
    FBGW --> FBCtrl["Feedback Ctrl"]
    FBCtrl -->|"score.request {answers[], rubricId?}"| FBSvc["Feedback Svc"]
    FBSvc -->|"getRubric {id or config}"| RubricSvc["Rubric Svc"]
    RubricSvc --> RubricsRepo["Rubrics Repo"]
    RubricsRepo --> PG["Postgres"]
    FBSvc -->|"scores[], rationale"| FBCtrl
    FBCtrl -->|"INSERT score rows"| ScoreRepo["Score Repo"]
    ScoreRepo --> PG
    FBSvc -->|"cache aggregates"| Redis[(Redis)]
    FBSvc -.->|"publish feedback.ready {sessionId, turnId}"| MQ[(RabbitMQ)]
    FBCtrl -->|"200 {scores}"| FBGW --> Client
