    G["🌐 API Gateway"]:::svc
    LTI["🎓 LTI Advantage Service"]:::svc
    I1["👤 Identity Service"]:::svc
    Orchestrator["🕹 Simulation Orchestrator"]:::svc
    Feedback["📝 Feedback Engine"]:::svc
    Analytics["📊 Analytics"]:::svc
