{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build", "db:generate:all"],
      "outputs": ["dist/**", ".next/**", "build/**"]
    },
    "lint": {
      "outputs": []
    },
    "lint:fix": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["db:generate:all"],
      "outputs": []
    },
    "test:watch": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["db:generate:all"]
    },
    "type-check": {
      "dependsOn": ["^build", "db:generate:all"],
      "outputs": []
    },
    "format": {
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "db:generate:all": {
      "cache": false,
      "outputs": ["**/prisma/generated/**"]
    },
    "db:migrate:all": {
      "cache": false,
      "outputs": []
    },
    "db:generate:user": {
      "cache": false,
      "outputs": ["src/microservices/user/prisma/generated/**"]
    },
    "db:generate:business": {
      "cache": false,
      "outputs": ["src/microservices/business/prisma/generated/**"]
    },
    "db:generate:auth": {
      "cache": false,
      "outputs": ["src/microservices/auth/prisma/generated/**"]
    },
    "db:migrate:user": {
      "cache": false,
      "outputs": []
    },
    "db:migrate:business": {
      "cache": false,
      "outputs": []
    },
    "db:migrate:auth": {
      "cache": false,
      "outputs": []
    }
  }
}
