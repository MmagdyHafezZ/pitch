# Database Configuration
POSTGRES_DB=pitch_app
POSTGRES_USER=pitch_user
POSTGRES_PASSWORD=your_secure_postgres_password_here

# MongoDB Configuration
MONGO_DB=pitch_app
MONGO_USER=pitch_user
MONGO_PASSWORD=your_secure_mongo_password_here

# RabbitMQ Configuration
RABBITMQ_USER=pitch_admin
RABBITMQ_PASSWORD=your_secure_rabbitmq_password_here
RABBITMQ_VHOST=pitch_local

# Application Secrets
JWT_SECRET=your_super_secure_jwt_secret_key_here_32_chars_minimum
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_key_here_32_chars_minimum
NEXTAUTH_SECRET=your_nextauth_secret_key_here

# Application URLs
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXTAUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Optional Configuration
LOG_LEVEL=info
NODE_ENV=development

# Monitoring (Production only)
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password_here