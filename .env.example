# =============================================================================
# PITCH Platform - Environment Variables
# =============================================================================
# This file shows all available environment variables with example values
#
# FOR LOCAL DEVELOPMENT (Docker Compose):
#   cp apps/api/.env.local apps/api/.env
#
# FOR PRODUCTION (Prisma Accelerate):
#   cp apps/api/.env.production apps/api/.env
#   Then update with your actual credentials
#
# DO NOT commit .env files to version control
# =============================================================================

# =============================================================================
# Application
# =============================================================================
NODE_ENV=development
# Options: development, staging, production
LOG_LEVEL=info
# Options: error, warn, info, debug

# =============================================================================
# PostgreSQL Database Configuration
# =============================================================================
# Shared credentials for all PostgreSQL databases
POSTGRES_USER=pitch_user
POSTGRES_PASSWORD=your_secure_postgres_password_here

# -----------------------------------------------------------------------------
# Prisma Accelerate Configuration
# -----------------------------------------------------------------------------
# Get your API key from https://console.prisma.io/
PRISMA_ACCELERATE_TOKEN=your_prisma_accelerate_api_key_here

# -----------------------------------------------------------------------------
# User Management Microservice Database
# -----------------------------------------------------------------------------
# Accelerate URL (connection pooler for application queries)
USER_DATABASE_URL=prisma://accelerate.prisma-data.net/?api_key=${PRISMA_ACCELERATE_TOKEN}
# Direct URL (for migrations and schema changes)
USER_DIRECT_URL=postgresql://pitch_user:your_password@localhost:5433/pitch_user

# -----------------------------------------------------------------------------
# Simulation Microservice Database
# -----------------------------------------------------------------------------
# Accelerate URL (connection pooler for application queries)
SIMULATION_DATABASE_URL=prisma://accelerate.prisma-data.net/?api_key=${PRISMA_ACCELERATE_TOKEN}
# Direct URL (for migrations and schema changes)
SIMULATION_DIRECT_URL=postgresql://pitch_user:your_password@localhost:5434/pitch_simulation

# -----------------------------------------------------------------------------
# Support Microservice Database
# -----------------------------------------------------------------------------
# Accelerate URL (connection pooler for application queries)
SUPPORT_DATABASE_URL=prisma://accelerate.prisma-data.net/?api_key=${PRISMA_ACCELERATE_TOKEN}
# Direct URL (for migrations and schema changes)
SUPPORT_DIRECT_URL=postgresql://pitch_user:your_password@localhost:5435/pitch_support

# -----------------------------------------------------------------------------
# Analytics Microservice Database
# -----------------------------------------------------------------------------
# Accelerate URL (connection pooler for application queries)
ANALYTICS_DATABASE_URL=prisma://accelerate.prisma-data.net/?api_key=${PRISMA_ACCELERATE_TOKEN}
# Direct URL (for migrations and schema changes)
ANALYTICS_DIRECT_URL=postgresql://pitch_user:your_password@localhost:5436/pitch_analytics

# -----------------------------------------------------------------------------
# CRM Microservice Database
# -----------------------------------------------------------------------------
# Accelerate URL (connection pooler for application queries)
CRM_DATABASE_URL=prisma://accelerate.prisma-data.net/?api_key=${PRISMA_ACCELERATE_TOKEN}
# Direct URL (for migrations and schema changes)
CRM_DIRECT_URL=postgresql://pitch_user:your_password@localhost:5437/pitch_crm

# =============================================================================
# MongoDB Configuration (UserManagement Service)
# =============================================================================
MONGO_URI=mongodb+srv://root:1rJ96lAc099GWD6r@pitch.ouksck9.mongodb.net/?appName=pitch
MONGO_DB_NAME="pitch-usermanagement"
MONGO_USER=admin
MONGO_PASSWORD=your_secure_mongo_password_here
# MONGODB_URL=mongodb://admin:password@localhost:27017/pitch_simulation?authSource=admin

# =============================================================================
# MongoDB Configuration (Simulation Service)
# =============================================================================
MONGO_USER=admin
MONGO_PASSWORD=your_secure_mongo_password_here
# MONGODB_URL=mongodb://admin:password@localhost:27017/pitch_simulation?authSource=admin

# =============================================================================
# Redis Configuration
# =============================================================================
# REDIS_URL=redis://localhost:6379

# =============================================================================
# RabbitMQ Configuration
# =============================================================================
RABBITMQ_USER=pitch_admin
RABBITMQ_PASSWORD=your_secure_rabbitmq_password_here
RABBITMQ_VHOST=pitch
# RABBITMQ_URL=amqp://admin:admin123@localhost:5672/pitch

# =============================================================================
# JWT Authentication
# =============================================================================
JWT_SECRET=your_super_secure_jwt_secret_key_here_32_chars_minimum
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# =============================================================================
# OAuth Providers (User Service)
# =============================================================================

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback

# Microsoft OAuth
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_CALLBACK_URL=http://localhost:8000/api/auth/microsoft/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:8000/api/auth/github/callback

# Discord OAuth
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_CALLBACK_URL=http://localhost:8000/api/auth/discord/callback

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_CALLBACK_URL=http://localhost:8000/api/auth/linkedin/callback

# =============================================================================
# AI/LLM Services (Simulation Service)
# =============================================================================

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4000
OPENAI_MODELS_URL=https://api.openai.com/v1/models
OPENAI_MODELS_AUTH_HEADER=
OPENAI_PRICING_URL=
OPENAI_PRICING_API_KEY=
OPENAI_PRICING_AUTH_HEADER=

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-opus-20240229

# Watsonx
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_SPECS_VERSION=2024-05-01
WATSONX_MODEL_SPECS_URL=
WATSONX_MODEL_SPECS_AUTH_HEADER=
WATSONX_PRICING_URL=
WATSONX_PRICING_API_KEY=
WATSONX_PRICING_AUTH_HEADER=

# LLM catalog/pricing caches
LLM_PRICING_CACHE_TTL_SECONDS=21600
LLM_MODEL_CATALOG_CACHE_TTL_SECONDS=21600

# =============================================================================
# Voice/Video Services (Simulation Service)
# =============================================================================

# Deepgram (Speech-to-Text)
DEEPGRAM_API_KEY=your-deepgram-api-key

# ElevenLabs (Text-to-Speech)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=default-voice-id

# =============================================================================
# LTI 1.3 Configuration (LTI Service)
# =============================================================================
LTI_PLATFORM_URL=https://your-lms-platform.com
LTI_CLIENT_ID=your-lti-client-id
LTI_DEPLOYMENT_ID=your-deployment-id
LTI_KEY_SET_URL=https://your-lms-platform.com/api/lti/security/jwks
LTI_AUTH_TOKEN_URL=https://your-lms-platform.com/api/lti/authorize

# =============================================================================
# AWS S3 Configuration (S3 Service)
# =============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=pitch-files-bucket

# =============================================================================
# CORS Configuration (API Gateway)
# =============================================================================
CORS_ORIGIN=http://localhost:3000
# For multiple origins: http://localhost:3000,https://app.yoursite.com

# =============================================================================
# Frontend Configuration (apps/web)
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_key_here
NEXT_TELEMETRY_DISABLED=1

# =============================================================================
# Email Service (Optional - for notifications)
# =============================================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@pitch.com

# =============================================================================
# Monitoring & Observability (Optional)
# =============================================================================
# SENTRY_DSN=https://your-sentry-dsn
# Grafana (Production only)
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password_here

# =============================================================================
# Rate Limiting (Optional)
# =============================================================================
# RATE_LIMIT_TTL=60
# RATE_LIMIT_MAX=100
